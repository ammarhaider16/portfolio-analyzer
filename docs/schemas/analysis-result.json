{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        },
        "content_type": {
          "default": "search_excerpt",
          "title": "Content Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "publisher"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "content": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "content"
      ],
      "title": "ReportSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "default": "success",
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "snapshot_as_of": {
      "format": "date-time",
      "title": "Snapshot As Of",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "coverage": {
      "additionalProperties": true,
      "title": "Coverage",
      "type": "object"
    },
    "executive_summary": {
      "default": "",
      "title": "Executive Summary",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "research_activity": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Research Activity",
      "type": "array"
    },
    "research_budget": {
      "additionalProperties": true,
      "title": "Research Budget",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "suggestions": {
      "items": {
        "type": "string"
      },
      "title": "Suggestions",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "snapshot_as_of"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
